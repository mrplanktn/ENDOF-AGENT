# ==============================================================================
# NexusAgent Environment Variables
# ==============================================================================
# Copy this file to .env and fill in your values.
# These override values from config/default_config.yaml.

# --- LLM Provider API Keys ---
OPENAI_API_KEY=sk-your-openai-key-here
ANTHROPIC_API_KEY=sk-ant-your-anthropic-key-here
GOOGLE_API_KEY=your-google-api-key-here
GROQ_API_KEY=gsk_your-groq-key-here
MISTRAL_API_KEY=your-mistral-key-here

# --- Gateway Platform Tokens ---
TELEGRAM_TOKEN=your-telegram-bot-token-here
DISCORD_TOKEN=your-discord-bot-token-here
# SLACK_BOT_TOKEN=xoxb-your-slack-token-here

# --- NexusAgent Settings ---
# NEXUS_DATA_DIR=~/.nexusagent
# NEXUS_LOG_LEVEL=INFO
# NEXUS_DEFAULT_PROVIDER=openai

# --- Security ---
# NEXUS_ENCRYPTION_KEY=your-encryption-key-here
